# Warehouse Service — Environment Variables
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DB_NAME=warehouse
DB_USER=warehouse_user
DB_PASSWORD=warehouse_password
DB_HOST=warehouse_db
DB_PORT=5432

# Redis (separate DB index from BookShop)
REDIS_URL=redis://redis:6379/1

# Inter-service communication
BOOK_SHOP_API_URL=http://book_shop_web:8000
BOOK_SHOP_API_TOKEN=your-bookshop-jwt-token
WEBHOOK_SECRET=shared-webhook-secret-change-me

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@warehouse.example.com
WAREHOUSE_MANAGER_EMAIL=manager@warehouse.example.com

# Sentry (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# Security (production)
SECURE_SSL_REDIRECT=False
